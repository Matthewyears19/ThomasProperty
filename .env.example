# Documentation only. Set runtime values in Cloudflare Variables and Secrets.
# Local Wrangler uses an ignored .dev.vars file, not this file.
ENQUIRIES_ENABLED=false
ANALYTICS_ENABLED=false
RESEND_API_KEY=
ENQUIRY_FROM=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Exact comma-separated origins, no trailing slash.
ALLOWED_ORIGINS=
# Random server-side secret, at least 32 bytes.
RATE_LIMIT_SALT=
# ENQUIRY_DB is a D1 binding, not a text variable. Apply migrations/0001_enquiries.sql.
