{
  "name": "thomasproperty",
  "keep_vars": true,
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFlsr94Fe54z6kZS"
  },
  "compatibility_date": "2026-10-25",
  "main": "./.worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "ENQUIRY_DB",
      "database_name": "thomas_db",
      "database_id": "3f34e987-85b6-4fbd-8e86-c0e16bd10316"
    }
  ]
}
