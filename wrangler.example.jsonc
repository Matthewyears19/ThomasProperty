// LOCAL DEVELOPMENT TEMPLATE ONLY: copy to an ignored wrangler.local.jsonc.
// Existing deployed Pages settings stay in the Cloudflare dashboard.
{
  "name": "thomas-property-services-local",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-25",
  "d1_databases": [{
    "binding": "ENQUIRY_DB",
    "database_name": "local-enquiries",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }]
}
